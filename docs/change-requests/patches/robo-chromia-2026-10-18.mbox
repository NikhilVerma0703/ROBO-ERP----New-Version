diff --git a/src/lib/attendance/attendance.ts b/src/lib/attendance/attendance.ts
new file mode 100644
index 0000000..31c9ba3
--- /dev/null
+++ b/src/lib/attendance/attendance.ts
@@ -0,0 +1,145 @@
+/**
+ * The Attendance register's own rules — the half that is pure arithmetic and
+ * text, so `node --test` can reach it and the two ERPs cannot drift apart by
+ * each deciding something for itself.
+ *
+ * Pure and alias-free, like lib/robo/productionDate.ts.
+ *
+ * ── ONE REGISTER, TWO ERPs ────────────────────────────────────────────────
+ * Robo and Chromia share the operators, so they share the register: the same
+ * three attendance_* tables, read and written by both. Nothing is copied
+ * between them and nothing has to be kept in step, because there is only ever
+ * one row — (date, operator) is unique in the database, so the same day
+ * entered from either screen is the same record, and an edit on one screen IS
+ * the edit on the other.
+ *
+ * Times are "HH:MM" and dates yyyy-mm-dd, the convention the shop floor
+ * already uses. No Date object, no timezone, anywhere in this file.
+ */
+
+/* ── The two lines ─────────────────────────────────────────────────── */
+
+/** Stored codes, in the order they are offered and shown. */
+export const LINES = ["ROBO", "CHROMIA"] as const;
+export type LineCode = (typeof LINES)[number];
+
+export const LINE_LABELS: Record<LineCode, string> = {
+  ROBO: "Robo Line",
+  CHROMIA: "Chromia Line",
+};
+
+/**
+ * The lines of a stored row: comma-joined codes, always in LINES order and
+ * never repeated, so "CHROMIA,ROBO" and "ROBO,ROBO,CHROMIA" both read as the
+ * one set they mean. Anything that is not a line is dropped rather than shown
+ * as a line nobody runs.
+ */
+export function parseLines(stored: string | null | undefined): LineCode[] {
+  const seen = new Set(
+    String(stored ?? "")
+      .split(",")
+      .map((s) => s.trim().toUpperCase())
+      .filter((s): s is LineCode => (LINES as readonly string[]).includes(s)),
+  );
+  return LINES.filter((l) => seen.has(l));
+}
+
+/** The storage form of a set of lines — the inverse of parseLines, and the
+ *  only thing that writes attendance_day.lines. */
+export function joinLines(lines: readonly string[]): string {
+  return parseLines(lines.join(",")).join(",");
+}
+
+/** "Robo Line", "Robo Line + Chromia Line", or "-" when none is set. */
+export function linesLabel(stored: string | null | undefined): string {
+  const l = parseLines(stored);
+  return l.length === 0 ? "-" : l.map((c) => LINE_LABELS[c]).join(" + ");
+}
+
+/* ── Worked hours ──────────────────────────────────────────────────── */
+
+/** Minutes since midnight for "HH:MM", or null. */
+function toMins(t: string | null | undefined): number | null {
+  const m = /^\s*(\d{1,2}):(\d{2})\s*$/.exec(t ?? "");
+  if (!m) return null;
+  const h = Number(m[1]);
+  const min = Number(m[2]);
+  return h > 23 || min > 59 ? null : h * 60 + min;
+}
+
+/** The longest shift the register will accept as one day's work. A night
+ *  shift that starts at 22:00 and ends at 06:00 is eight hours; anything past
+ *  sixteen is a typed Out that belongs to a different day. */
+export const MAX_SHIFT_MINUTES = 16 * 60;
+
+/**
+ * Minutes worked between an In and an Out, or null when the pair cannot say.
+ *
+ * An Out earlier than the In is the night shift crossing midnight (22:00 →
+ * 06:00 is 8 hours), the same reading the Robo delay log and the hourly
+ * reports already use. Equal times are null, not zero: nobody works a shift of
+ * no length, so it is a typo rather than a reading. Past MAX_SHIFT_MINUTES it
+ * is null too — an inverted or mistyped pair should show as nothing rather
+ * than as an impossible day.
+ */
+export function workedMinutes(inTime: string | null | undefined, outTime: string | null | undefined): number | null {
+  const a = toMins(inTime);
+  const b = toMins(outTime);
+  if (a === null || b === null) return null;
+  let diff = b - a;
+  if (diff < 0) diff += 24 * 60;
+  if (diff <= 0 || diff > MAX_SHIFT_MINUTES) return null;
+  return diff;
+}
+
+/** "8h 15m", "45m" — the same shape fmtDuration gives everywhere else, and
+ *  "-" when there is nothing to show. */
+export function workedLabel(inTime: string | null | undefined, outTime: string | null | undefined): string {
+  const mins = workedMinutes(inTime, outTime);
+  if (mins === null) return "-";
+  const h = Math.floor(mins / 60);
+  const m = mins % 60;
+  return h > 0 ? (m > 0 ? `${h}h ${m}m` : `${h}h`) : `${m}m`;
+}
+
+/** The hours away on a leave row, by the same rule. Both times empty is the
+ *  whole day, which the register writes in words rather than as a number. */
+export function leaveLabel(fromTime: string | null | undefined, toTime: string | null | undefined): string {
+  const from = (fromTime ?? "").trim();
+  const to = (toTime ?? "").trim();
+  if (!from && !to) return "Full day";
+  if (!from || !to) return from || to;
+  return `${from}–${to}`;
+}
+
+/* ── Sorting ───────────────────────────────────────────────────────── */
+
+/**
+ * Operator names in alphabetical order, as the register shows them.
+ *
+ * Compared case- and punctuation-insensitively so "Praveen Kumar.S" and
+ * "praveen kumar s" sort as the same word — the register is typed by hand and
+ * a stray capital should not move a name down the page.
+ */
+export function compareOperatorNames(a: string, b: string): number {
+  const key = (s: string) => s.replace(/[^\p{L}\p{N}]+/gu, " ").trim().toLocaleLowerCase();
+  return key(a).localeCompare(key(b)) || a.localeCompare(b);
+}
+
+/* ── What an operator's name may be ────────────────────────────────── */
+
+/** A typed operator name, tidied: inner runs of space collapsed, ends
+ *  trimmed. "" when there is nothing left, which the caller refuses. */
+export function cleanOperatorName(raw: unknown): string {
+  return String(raw ?? "").replace(/\s+/g, " ").trim();
+}
+
+export const OPERATOR_NAME_MAX = 80;
+
+/** Why a name cannot be used, or null when it can. */
+export function operatorNameError(raw: unknown): string | null {
+  const name = cleanOperatorName(raw);
+  if (!name) return "Enter the operator's name.";
+  if (name.length > OPERATOR_NAME_MAX) return `Keep the name under ${OPERATOR_NAME_MAX} characters.`;
+  return null;
+}
diff --git a/src/lib/attendance/filters.ts b/src/lib/attendance/filters.ts
new file mode 100644
index 0000000..6502940
--- /dev/null
+++ b/src/lib/attendance/filters.ts
@@ -0,0 +1,175 @@
+/**
+ * The Attendance Downloads filter — which records the page lists and the
+ * spreadsheet then contains.
+ *
+ * Pure and alias-free so `node --test` can reach it. The SAME function decides
+ * both, which is the point: the sheet is the table you were just looking at,
+ * never a second query that could answer differently.
+ *
+ * Dates are yyyy-mm-dd strings throughout and the arithmetic is done in whole
+ * days since the epoch, in UTC — so "last week" is seven calendar days and
+ * nothing shifts across a timezone.
+ */
+
+export const RECORD_TYPES = ["ATTENDANCE", "LEAVE"] as const;
+export type RecordType = (typeof RECORD_TYPES)[number];
+
+export const RECORD_TYPE_LABELS: Record<RecordType, string> = {
+  ATTENDANCE: "Attendance",
+  LEAVE: "Leave",
+};
+
+/**
+ * How the period is chosen. They are modes, not separate filters: a date and a
+ * month cannot both be in force, and offering them as independent boxes is how
+ * a screen ends up with a filter the reader cannot explain.
+ */
+export const PERIOD_MODES = ["DATE", "LAST_WEEK", "MONTH", "RANGE", "ALL"] as const;
+export type PeriodMode = (typeof PERIOD_MODES)[number];
+
+export const PERIOD_LABELS: Record<PeriodMode, string> = {
+  DATE: "A single date",
+  LAST_WEEK: "Last week",
+  MONTH: "Month-wise",
+  RANGE: "Custom date range",
+  ALL: "All records",
+};
+
+export interface AttendanceFilter {
+  type: RecordType;
+  /** One operator's id, or "" for every operator. */
+  operatorId: string;
+  period: PeriodMode;
+  /** PERIOD "DATE". */
+  date?: string;
+  /** PERIOD "RANGE". Either end may be left empty, which leaves it open. */
+  from?: string;
+  to?: string;
+  /** PERIOD "MONTH", as yyyy-mm. */
+  month?: string;
+}
+
+/** Whole days since the epoch for a yyyy-mm-dd, or null. UTC, so no timezone
+ *  moves the day. */
+export function dayNum(d: string | null | undefined): number | null {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec((d ?? "").trim());
+  if (!m) return null;
+  const n = Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
+  return Number.isFinite(n) ? Math.floor(n / 86_400_000) : null;
+}
+
+/** The inverse. */
+export function dateFromDayNum(dn: number): string {
+  return new Date(dn * 86_400_000).toISOString().slice(0, 10);
+}
+
+/** The last day of a yyyy-mm month: the day before the first of the next. */
+function lastOfMonth(year: number, month1: number): string {
+  const firstOfNext = Date.UTC(month1 === 12 ? year + 1 : year, month1 === 12 ? 0 : month1, 1);
+  return dateFromDayNum(Math.floor(firstOfNext / 86_400_000) - 1);
+}
+
+/** How many days "last week" covers, today included. */
+export const LAST_WEEK_DAYS = 7;
+
+/**
+ * The inclusive yyyy-mm-dd bounds the filter covers. A null bound is open —
+ * "All records" is open at both ends, and a half-filled custom range is open
+ * at the end left blank rather than silently becoming today.
+ *
+ * `today` is passed in rather than read from the clock, so the same filter
+ * always gives the same window in a test and the server and the page cannot
+ * disagree about what day it is.
+ */
+export function periodBounds(f: AttendanceFilter, today: string): { from: string | null; to: string | null } {
+  switch (f.period) {
+    case "DATE": {
+      const d = dayNum(f.date) === null ? null : (f.date as string);
+      return { from: d, to: d };
+    }
+    case "LAST_WEEK": {
+      const t = dayNum(today);
+      if (t === null) return { from: null, to: null };
+      return { from: dateFromDayNum(t - (LAST_WEEK_DAYS - 1)), to: today };
+    }
+    case "MONTH": {
+      const m = /^(\d{4})-(\d{2})$/.exec((f.month ?? "").trim());
+      if (!m) return { from: null, to: null };
+      const year = Number(m[1]);
+      const month1 = Number(m[2]);
+      if (month1 < 1 || month1 > 12) return { from: null, to: null };
+      return { from: `${m[1]}-${m[2]}-01`, to: lastOfMonth(year, month1) };
+    }
+    case "RANGE": {
+      const a = dayNum(f.from) === null ? null : (f.from as string);
+      const b = dayNum(f.to) === null ? null : (f.to as string);
+      // Typed the wrong way round reads as the range they meant, not as empty.
+      if (a !== null && b !== null && a > b) return { from: b, to: a };
+      return { from: a, to: b };
+    }
+    default:
+      return { from: null, to: null };
+  }
+}
+
+/** A row of either register, as far as filtering cares. */
+export interface FilterableRow {
+  date: string;
+  operatorId: string;
+}
+
+/** Does this row pass the filter? Operator and period are ANDed — picking an
+ *  operator AND a month gives that operator's rows in that month, which is
+ *  what both of them being set has to mean. */
+export function matchesFilter(row: FilterableRow, f: AttendanceFilter, today: string): boolean {
+  if (f.operatorId && row.operatorId !== f.operatorId) return false;
+  const { from, to } = periodBounds(f, today);
+  // yyyy-mm-dd compares as text exactly as it compares as a date.
+  if (from !== null && row.date < from) return false;
+  if (to !== null && row.date > to) return false;
+  return true;
+}
+
+/** The filter in words, for the heading above the results and the sheet's own
+ *  first line: "Attendance · Praveen Kumar.S · October 2026". */
+export function describeFilter(f: AttendanceFilter, today: string, operatorName: string): string {
+  const parts: string[] = [RECORD_TYPE_LABELS[f.type]];
+  parts.push(f.operatorId ? operatorName || "Operator" : "All operators");
+  const { from, to } = periodBounds(f, today);
+  if (from === null && to === null) parts.push("All dates");
+  else if (from === to) parts.push(String(from));
+  else parts.push(`${from ?? "the start"} → ${to ?? "today"}`);
+  return parts.join(" · ");
+}
+
+/** The download's file name — the filter, so two downloads never collide in a
+ *  Downloads folder. */
+export function filterFileName(f: AttendanceFilter, today: string, operatorName: string): string {
+  const safe = (s: string) => s.replace(/[^a-zA-Z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "all";
+  const { from, to } = periodBounds(f, today);
+  const span = from === null && to === null ? "all" : from === to ? String(from) : `${from ?? "start"}_${to ?? today}`;
+  const who = f.operatorId ? safe(operatorName) : "all-operators";
+  return `${RECORD_TYPE_LABELS[f.type]}_${who}_${span}.xlsx`;
+}
+
+/* ── The sheets ────────────────────────────────────────────────────── */
+
+/** The Attendance sheet's columns, in the order the register shows them. */
+export const ATTENDANCE_COLUMNS = [
+  "Date", "Operator Name", "Line", "In-Time", "Out-Time", "Total Working Hours",
+] as const;
+export const ATTENDANCE_WIDTHS = [13, 24, 24, 10, 10, 20];
+
+/** The Leave sheet's, likewise. */
+export const LEAVE_COLUMNS = [
+  "Date", "S.No.", "Operator Name", "Leave Time", "Leave Reason", "Remarks",
+] as const;
+export const LEAVE_WIDTHS = [13, 7, 24, 16, 32, 32];
+
+export function columnsFor(type: RecordType): readonly string[] {
+  return type === "LEAVE" ? LEAVE_COLUMNS : ATTENDANCE_COLUMNS;
+}
+
+export function widthsFor(type: RecordType): number[] {
+  return type === "LEAVE" ? LEAVE_WIDTHS : ATTENDANCE_WIDTHS;
+}
diff --git a/src/lib/attendance/server.ts b/src/lib/attendance/server.ts
new file mode 100644
index 0000000..91a41b0
--- /dev/null
+++ b/src/lib/attendance/server.ts
@@ -0,0 +1,418 @@
+/**
+ * The Attendance API — ONE implementation, mounted twice.
+ *
+ * ── WHY ONE FILE AND NOT TWO SETS OF ROUTES ───────────────────────────────
+ * Robo and Chromia must always show the same register, so there is one set of
+ * tables and one set of handlers. What differs between the two ERPs is only
+ * which gate lets you in: /api/robo/attendance/… is behind roboGate and the
+ * middleware's /api/robo rule, /api/chromia/attendance/… behind chromiaGate
+ * and the /api/chromia rule. Each module's route file is five lines — its own
+ * gate, then this.
+ *
+ * It is NOT mounted at a new /api/attendance prefix, which would be the
+ * obvious thing and is wrong twice over: middleware has no rule for it, so
+ * every other department's login would reach it, while the ROBO and CHROMIA
+ * role caps (which allow only their own module's paths) would lock out the two
+ * logins that actually need it.
+ *
+ * Twenty near-identical route files — ten endpoints in two modules — would be
+ * the alternative, and Nav.tsx already records what happens to hand-kept
+ * copies: they drift the first time one of them is edited. So the dispatch is
+ * by path here, once.
+ */
+
+import * as XLSX from "xlsx-js-style";
+import { prisma } from "@/lib/prisma";
+import { styleRoboSheet } from "@/lib/robo/exportStyle";
+import { toPlantDateInput } from "@/lib/chromia/plant-time";
+import { isValidTime } from "@/lib/robo/time";
+import {
+  cleanOperatorName,
+  compareOperatorNames,
+  joinLines,
+  leaveLabel,
+  linesLabel,
+  operatorNameError,
+  workedLabel,
+} from "./attendance.ts";
+import {
+  ATTENDANCE_COLUMNS,
+  LEAVE_COLUMNS,
+  PERIOD_MODES,
+  RECORD_TYPES,
+  columnsFor,
+  describeFilter,
+  filterFileName,
+  periodBounds,
+  widthsFor,
+  type AttendanceFilter,
+  type PeriodMode,
+  type RecordType,
+} from "./filters.ts";
+
+/** Today, on the plant's clock rather than the server's — the host runs in UTC
+ *  and "last week" must not start a day early for a night shift. */
+const todayPlant = () => toPlantDateInput(new Date());
+
+const json = (body: unknown, status = 200) =>
+  Response.json(body, { status, headers: { "Cache-Control": "no-store" } });
+const bad = (message: string, status = 400) => json({ error: message }, status);
+
+const isDate = (v: unknown): v is string => /^\d{4}-\d{2}-\d{2}$/.test(String(v ?? ""));
+
+/** A typed time as it is stored: "HH:MM", or null for an empty box. Anything
+ *  that is not a time is refused rather than stored as text nobody can total. */
+function timeOrNull(v: unknown): string | null | undefined {
+  const s = String(v ?? "").trim();
+  if (!s) return null;
+  return isValidTime(s) ? s : undefined; // undefined = invalid, the caller refuses
+}
+
+/* ── Operators ─────────────────────────────────────────────────────── */
+
+async function listOperators() {
+  const rows = await prisma.attendanceOperator.findMany({
+    select: { id: true, name: true, isActive: true },
+  });
+  // Alphabetical, the way the register reads — not by when they were added.
+  return rows.sort((a, b) => compareOperatorNames(a.name, b.name));
+}
+
+/* ── The day's register ────────────────────────────────────────────── */
+
+/**
+ * Every active operator for a date, each with their row if one exists. The
+ * register is the roster, not the rows: an operator with nothing entered yet
+ * still has a line to fill in, which is the whole point of a register.
+ */
+async function dayRegister(date: string) {
+  const [operators, days] = await Promise.all([
+    listOperators(),
+    prisma.attendanceDay.findMany({ where: { date } }),
+  ]);
+  const byOperator = new Map(days.map((d) => [d.operatorId, d]));
+  return operators
+    .filter((o) => o.isActive || byOperator.has(o.id))
+    .map((o) => {
+      const d = byOperator.get(o.id);
+      return {
+        operatorId: o.id,
+        operatorName: o.name,
+        isActive: o.isActive,
+        lines: d?.lines ?? "",
+        linesLabel: linesLabel(d?.lines),
+        inTime: d?.inTime ?? "",
+        outTime: d?.outTime ?? "",
+        worked: workedLabel(d?.inTime, d?.outTime),
+        saved: Boolean(d),
+      };
+    });
+}
+
+/* ── Leave ─────────────────────────────────────────────────────────── */
+
+async function listLeave() {
+  const rows = await prisma.attendanceLeave.findMany({
+    orderBy: [{ date: "desc" }, { createdAt: "asc" }],
+    take: 500,
+    include: { operator: { select: { name: true } } },
+  });
+  /* S.No. is the row's 1..N position within its own date, computed here and
+     never stored — the same rule Slab Records follows, and for the same
+     reason: a typed serial on a register gets mistyped and then two rows
+     claim the same number. */
+  const seenPerDate = new Map<string, number>();
+  const dated = [...rows].sort((a, b) => a.date.localeCompare(b.date) || a.createdAt.getTime() - b.createdAt.getTime());
+  const serials = new Map<string, number>();
+  for (const r of dated) {
+    const n = (seenPerDate.get(r.date) ?? 0) + 1;
+    seenPerDate.set(r.date, n);
+    serials.set(r.id, n);
+  }
+  return rows.map((r) => ({
+    id: r.id,
+    date: r.date,
+    serial: serials.get(r.id) ?? 1,
+    operatorId: r.operatorId,
+    operatorName: r.operator?.name ?? "",
+    fromTime: r.fromTime ?? "",
+    toTime: r.toTime ?? "",
+    leaveTime: leaveLabel(r.fromTime, r.toTime),
+    reason: r.reason ?? "",
+    remarks: r.remarks ?? "",
+  }));
+}
+
+/* ── Downloads ─────────────────────────────────────────────────────── */
+
+function readFilter(p: URLSearchParams): AttendanceFilter {
+  const type = (RECORD_TYPES as readonly string[]).includes(String(p.get("type")))
+    ? (p.get("type") as RecordType)
+    : "ATTENDANCE";
+  const period = (PERIOD_MODES as readonly string[]).includes(String(p.get("period")))
+    ? (p.get("period") as PeriodMode)
+    : "ALL";
+  return {
+    type,
+    period,
+    operatorId: p.get("operatorId") ?? "",
+    date: p.get("date") ?? undefined,
+    from: p.get("from") ?? undefined,
+    to: p.get("to") ?? undefined,
+    month: p.get("month") ?? undefined,
+  };
+}
+
+/** The where-clause a filter means. The period is turned into bounds once, by
+ *  periodBounds, so the page's table and the spreadsheet cannot disagree. */
+function filterWhere(f: AttendanceFilter, today: string) {
+  const { from, to } = periodBounds(f, today);
+  const where: { operatorId?: string; date?: { gte?: string; lte?: string } } = {};
+  if (f.operatorId) where.operatorId = f.operatorId;
+  if (from !== null || to !== null) {
+    where.date = {};
+    if (from !== null) where.date.gte = from;
+    if (to !== null) where.date.lte = to;
+  }
+  return where;
+}
+
+/** The rows a filter selects, already shaped as the table and the sheet show
+ *  them — ONE function behind both, so the download is the table you looked at. */
+async function filteredRows(f: AttendanceFilter, today: string) {
+  const where = filterWhere(f, today);
+  if (f.type === "LEAVE") {
+    const rows = await prisma.attendanceLeave.findMany({
+      where,
+      orderBy: [{ date: "asc" }, { createdAt: "asc" }],
+      include: { operator: { select: { name: true } } },
+    });
+    const perDate = new Map<string, number>();
+    return rows.map((r) => {
+      const n = (perDate.get(r.date) ?? 0) + 1;
+      perDate.set(r.date, n);
+      return {
+        "Date": r.date,
+        "S.No.": n,
+        "Operator Name": r.operator?.name ?? "",
+        "Leave Time": leaveLabel(r.fromTime, r.toTime),
+        "Leave Reason": r.reason ?? "",
+        "Remarks": r.remarks ?? "",
+      } as Record<string, string | number>;
+    });
+  }
+  const rows = await prisma.attendanceDay.findMany({
+    where,
+    orderBy: [{ date: "asc" }],
+    include: { operator: { select: { name: true } } },
+  });
+  return [...rows]
+    .sort((a, b) => a.date.localeCompare(b.date) || compareOperatorNames(a.operator?.name ?? "", b.operator?.name ?? ""))
+    .map((r) => ({
+      "Date": r.date,
+      "Operator Name": r.operator?.name ?? "",
+      "Line": linesLabel(r.lines),
+      "In-Time": r.inTime ?? "-",
+      "Out-Time": r.outTime ?? "-",
+      "Total Working Hours": workedLabel(r.inTime, r.outTime),
+    }) as Record<string, string | number>);
+}
+
+async function operatorNameOf(id: string): Promise<string> {
+  if (!id) return "";
+  const row = await prisma.attendanceOperator.findUnique({ where: { id }, select: { name: true } });
+  return row?.name ?? "";
+}
+
+/* ── The one handler ───────────────────────────────────────────────── */
+
+/**
+ * Dispatch on the path AFTER ".../attendance". Both module routes hand their
+ * own segments in, so the same request reaches the same code whichever ERP
+ * asked.
+ */
+export async function attendanceApi(req: Request, segments: string[]): Promise<Response> {
+  const url = new URL(req.url);
+  const p = url.searchParams;
+  const [head, id] = segments;
+  const method = req.method.toUpperCase();
+  const body = method === "GET" || method === "DELETE" ? {} : await req.json().catch(() => ({}));
+
+  /* operators */
+  if (head === "operators" && !id) {
+    if (method === "GET") return json(await listOperators());
+    if (method === "POST") {
+      const name = cleanOperatorName((body as { name?: unknown }).name);
+      const err = operatorNameError(name);
+      if (err) return bad(err);
+      const clash = await prisma.attendanceOperator.findUnique({ where: { name }, select: { id: true } });
+      if (clash) return bad(`${name} is already on the list.`, 409);
+      const row = await prisma.attendanceOperator.create({ data: { name }, select: { id: true, name: true, isActive: true } });
+      return json(row, 201);
+    }
+  }
+
+  if (head === "operators" && id) {
+    if (method === "PATCH") {
+      const data: { name?: string; isActive?: boolean } = {};
+      if ((body as { name?: unknown }).name !== undefined) {
+        const name = cleanOperatorName((body as { name?: unknown }).name);
+        const err = operatorNameError(name);
+        if (err) return bad(err);
+        const clash = await prisma.attendanceOperator.findFirst({ where: { name, NOT: { id } }, select: { id: true } });
+        if (clash) return bad(`${name} is already on the list.`, 409);
+        data.name = name;
+      }
+      if (typeof (body as { isActive?: unknown }).isActive === "boolean") data.isActive = (body as { isActive: boolean }).isActive;
+      if (Object.keys(data).length === 0) return bad("Nothing to change.");
+      const row = await prisma.attendanceOperator.update({ where: { id }, data, select: { id: true, name: true, isActive: true } });
+      return json(row);
+    }
+    if (method === "DELETE") {
+      /* An operator who has ever been marked present is part of the record, so
+         deleting them would take their attendance with them. They are switched
+         off instead and keep their history; one who has never been used is
+         simply removed. The caller is told which happened. */
+      const [days, leaves] = await Promise.all([
+        prisma.attendanceDay.count({ where: { operatorId: id } }),
+        prisma.attendanceLeave.count({ where: { operatorId: id } }),
+      ]);
+      if (days + leaves > 0) {
+        const row = await prisma.attendanceOperator.update({ where: { id }, data: { isActive: false }, select: { name: true } });
+        return json({ deactivated: true, name: row.name, records: days + leaves });
+      }
+      await prisma.attendanceOperator.delete({ where: { id } });
+      return json({ deleted: true });
+    }
+  }
+
+  /* the day's register */
+  if (head === "day") {
+    if (method === "GET") {
+      const date = isDate(p.get("date")) ? (p.get("date") as string) : todayPlant();
+      return json({ date, rows: await dayRegister(date) });
+    }
+    if (method === "PUT") {
+      const b = body as { date?: unknown; operatorId?: unknown; lines?: unknown; inTime?: unknown; outTime?: unknown };
+      if (!isDate(b.date)) return bad("Pick a date.");
+      const operatorId = String(b.operatorId ?? "");
+      if (!operatorId) return bad("Pick an operator.");
+      const inTime = timeOrNull(b.inTime);
+      const outTime = timeOrNull(b.outTime);
+      if (inTime === undefined) return bad("In-Time is not a valid time.");
+      if (outTime === undefined) return bad("Out-Time is not a valid time.");
+      const lines = joinLines(Array.isArray(b.lines) ? b.lines.map(String) : String(b.lines ?? "").split(","));
+      /* The upsert IS the "no duplicates" rule: (date, operatorId) is unique in
+         the database, so the same day saved from Robo and from Chromia is one
+         row that the second save corrects rather than a second row. */
+      const row = await prisma.attendanceDay.upsert({
+        where: { date_operatorId: { date: b.date, operatorId } },
+        create: { date: b.date, operatorId, lines, inTime, outTime },
+        update: { lines, inTime, outTime },
+      });
+      return json({
+        operatorId,
+        lines: row.lines,
+        linesLabel: linesLabel(row.lines),
+        inTime: row.inTime ?? "",
+        outTime: row.outTime ?? "",
+        worked: workedLabel(row.inTime, row.outTime),
+        saved: true,
+      });
+    }
+  }
+
+  /* leave */
+  if (head === "leave" && !id) {
+    if (method === "GET") return json(await listLeave());
+    if (method === "POST") {
+      const b = body as Record<string, unknown>;
+      if (!isDate(b.date)) return bad("Pick a date.");
+      const operatorId = String(b.operatorId ?? "");
+      if (!operatorId) return bad("Pick an operator.");
+      const fromTime = timeOrNull(b.fromTime);
+      const toTime = timeOrNull(b.toTime);
+      if (fromTime === undefined || toTime === undefined) return bad("Leave time is not a valid time.");
+      await prisma.attendanceLeave.create({
+        data: {
+          date: b.date,
+          operatorId,
+          fromTime,
+          toTime,
+          reason: String(b.reason ?? "").trim(),
+          remarks: String(b.remarks ?? "").trim() || null,
+        },
+      });
+      return json(await listLeave(), 201);
+    }
+  }
+
+  if (head === "leave" && id) {
+    if (method === "PATCH") {
+      const b = body as Record<string, unknown>;
+      const data: Record<string, unknown> = {};
+      if (b.date !== undefined) {
+        if (!isDate(b.date)) return bad("Pick a date.");
+        data.date = b.date;
+      }
+      if (b.operatorId !== undefined) {
+        if (!String(b.operatorId ?? "")) return bad("Pick an operator.");
+        data.operatorId = String(b.operatorId);
+      }
+      for (const k of ["fromTime", "toTime"] as const) {
+        if (b[k] !== undefined) {
+          const t = timeOrNull(b[k]);
+          if (t === undefined) return bad("Leave time is not a valid time.");
+          data[k] = t;
+        }
+      }
+      if (b.reason !== undefined) data.reason = String(b.reason ?? "").trim();
+      if (b.remarks !== undefined) data.remarks = String(b.remarks ?? "").trim() || null;
+      if (Object.keys(data).length === 0) return bad("Nothing to change.");
+      await prisma.attendanceLeave.update({ where: { id }, data });
+      return json(await listLeave());
+    }
+    if (method === "DELETE") {
+      await prisma.attendanceLeave.delete({ where: { id } });
+      return json(await listLeave());
+    }
+  }
+
+  /* downloads — the table, then the same rows as a sheet */
+  if (head === "records" && method === "GET") {
+    const f = readFilter(p);
+    const today = todayPlant();
+    const rows = await filteredRows(f, today);
+    return json({
+      columns: columnsFor(f.type),
+      rows,
+      description: describeFilter(f, today, await operatorNameOf(f.operatorId)),
+    });
+  }
+
+  if (head === "export" && method === "GET") {
+    const f = readFilter(p);
+    const today = todayPlant();
+    const rows = await filteredRows(f, today);
+    const columns = [...columnsFor(f.type)];
+    const ws = XLSX.utils.json_to_sheet(rows, { header: columns });
+    ws["!cols"] = widthsFor(f.type).map((wch) => ({ wch }));
+    styleRoboSheet(ws, { columnCount: columns.length });
+    const wb = XLSX.utils.book_new();
+    XLSX.utils.book_append_sheet(wb, ws, (f.type === "LEAVE" ? "Leave" : "Attendance").slice(0, 31));
+    const buf = XLSX.write(wb, { type: "buffer", bookType: "xlsx" });
+    return new Response(buf, {
+      status: 200,
+      headers: {
+        "Content-Type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+        "Content-Disposition": `attachment; filename="${filterFileName(f, today, await operatorNameOf(f.operatorId))}"`,
+        "Cache-Control": "no-store",
+      },
+    });
+  }
+
+  return bad("Not found", 404);
+}
+
+/** Re-exported so a test can check the sheets match the registers on screen. */
+export { ATTENDANCE_COLUMNS, LEAVE_COLUMNS };
