+   tablet operator meets one set of controls across the ERP. */
+const inp = "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20 disabled:bg-gray-50 disabled:text-gray-400";
+const label = "mb-1 block text-xs font-medium text-gray-600";
+const btnPrimary = "rounded-lg bg-brand px-4 py-2 text-sm font-medium text-white transition hover:bg-brand/90 disabled:opacity-60 [@media_screen_and_(pointer:coarse)]:min-h-[44px]";
+const btnGhost = "rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50 [@media_screen_and_(pointer:coarse)]:min-h-[44px]";
+const th = "whitespace-nowrap px-3 py-2.5 text-left text-xs font-semibold uppercase tracking-wide text-gray-500";
+const td = "px-3 py-2.5 align-top text-sm text-gray-700";
+
+/** Today on the device's own calendar — the register opens on today. */
+const todayStr = () => {
+  const d = new Date();
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+};
+const thisMonth = () => todayStr().slice(0, 7);
+
+interface DayRow {
+  operatorId: string;
+  operatorName: string;
+  isActive: boolean;
+  lines: string;
+  linesLabel: string;
+  inTime: string;
+  outTime: string;
