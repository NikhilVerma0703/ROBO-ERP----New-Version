+test("anything that is not a time is no shift at all", () => {
+  for (const t of ["", "  ", null, undefined, "-", "abc", "25:00", "12:99", "9", "12-30"]) {
+    assert.equal(shiftFromTime(t as string), null, String(t));
+  }
+});
