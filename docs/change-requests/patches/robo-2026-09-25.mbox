+/* ── the subtitle, and the wiring that keeps chart, subtitle and KPI one rule ── */
+
+test("the subtitle names the run's first In and last Out: 'Batch D-1432 · 31/08/2026 (11:20) → 31/08/2026 (22:31) — …'", () => {
