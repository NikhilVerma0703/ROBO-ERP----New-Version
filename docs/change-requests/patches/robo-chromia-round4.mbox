+    { productionDate: "2026-09-01", inTime: "23:00", outTime: "23:50" },
+    { productionDate: "2026-09-02", inTime: "00:10", outTime: "00:45" },
+    { productionDate: "2026-09-02", inTime: "01:00", outTime: "01:30" },
+  ]);
