# Robo ERP (standalone) — copy this file to .env and fill it in.
# .env is git-ignored. Never commit a real password.

# PostgreSQL connection string. A local database is all this app needs:
#   postgresql://<user>:<password>@localhost:5432/robo_erp?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/robo_erp?schema=public"

# Optional: the name shown in the sidebar card. There is no sign-in: every
# action runs as one local admin user. Default: "Local User".
ROBO_ACTING_USER_NAME="Local User"

# Optional, for testing only: see the screens as another main-ERP login would.
# Leave unset for the normal full-access (admin) view.
#   ROBO_LOCAL_ROLE=ROBO             the Robo line tablet (operator tier)
#   ROBO_LOCAL_ROLE=PLANT_INCHARGE   the Plant In-Charge
# ROBO_LOCAL_ROLE=
